# Server-only. Personal access token for the Airtable API.
# Do not prefix with NEXT_PUBLIC_. Replace before deploy.
AIRTABLE_API_KEY=your_airtable_personal_access_token

# Server-only. Airtable base ID, starting with "app".
# Do not prefix with NEXT_PUBLIC_. Replace before deploy.
AIRTABLE_BASE_ID=your_airtable_base_id

# Server-only. Exact Airtable table name for new leads.
# Do not prefix with NEXT_PUBLIC_.
AIRTABLE_TABLE_NAME=Didact Capital Leads

# Public contact email shown in the footer and on the form success state.
# Set this to the live domain email before deploy.
NEXT_PUBLIC_CONTACT_EMAIL=Curry@didactcapital.fund
