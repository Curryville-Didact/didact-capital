# Server-only. Personal access token for the Airtable API.
# Do not prefix with NEXT_PUBLIC_. Replace before deploy.
AIRTABLE_API_KEY=your_airtable_personal_access_token

# Server-only. Airtable base ID, starting with "app".
# Do not prefix with NEXT_PUBLIC_. Replace before deploy.
AIRTABLE_BASE_ID=your_airtable_base_id

# Server-only. Exact Airtable table name for new leads.
# Do not prefix with NEXT_PUBLIC_.
AIRTABLE_TABLE_NAME=Didact Capital Leads

# Server-only. Applications table in the same Airtable base. Optional.
# Defaults to Applications when unset.
# AIRTABLE_APPLICATIONS_TABLE=Applications

# Server-only. Vercel Blob read/write token for bank statement uploads.
# Do not prefix with NEXT_PUBLIC_. Create it in the Vercel project Storage settings.
BLOB_READ_WRITE_TOKEN=your_vercel_blob_read_write_token

# Server-only. 32-byte key used to encrypt Social Security numbers before they are stored.
# Use a strong random value, for example: openssl rand -base64 32
# Do not prefix with NEXT_PUBLIC_. Never commit the real key.
SSN_ENCRYPTION_KEY=replace_with_openssl_rand_base64_32

# Server-only shared secret required in the x-lender-export-secret header.
# Do not prefix with NEXT_PUBLIC_. Never commit the real secret.
LENDER_EXPORT_SECRET=replace_with_a_long_random_secret

# Server-only. Resend API key for new-application notifications.
# Do not prefix with NEXT_PUBLIC_. Never commit the real key.
RESEND_API_KEY=re_your_resend_api_key

# Server-only. Verified sender address for Resend.
# Do not prefix with NEXT_PUBLIC_.
RESEND_FROM_EMAIL=Didact Capital <notifications@didactcapital.fund>

# Public contact email shown in the footer and on the form success state.
# Set this to the live domain email before deploy.
NEXT_PUBLIC_CONTACT_EMAIL=Curry@didactcapital.fund
